#!/bin/bash
set -e
cd ~/.local/share/chezmoi

# Re-add all managed files that differ between source and target.
# This captures any on-machine edits to dotfiles, configs, and Neovim plugins.
#
# kdeglobals is excluded: KDE replaces ColorScheme names with hashes and
# drops widgetStyle/[Icons] on write. Re-adding would overwrite our fix.
echo ">> Syncing managed dotfiles..."

# Build exclude list (files that drift due to application behavior)
# kdeglobals: KDE replaces ColorScheme names with hashes and drops widgetStyle/[Icons] on write
# plasmashellrc: Plasma adds migration entries to [Updates]/performed=
# kconf_updaterc: KDE updates migration timestamps
# plasma-org.kde.plasma.desktop-appletsrc: panel layout contains UUIDs
EXCLUDE_PATTERNS="kdeglobals plasmashellrc kconf_updaterc plasma-org"

# Get all managed files, filter out excludes, re-add
chezmoi managed --include=files 2>/dev/null | while read -r file; do
  skip=false
  for pattern in $EXCLUDE_PATTERNS; do
    if echo "$file" | grep -q "$pattern"; then
      skip=true
      break
    fi
  done
  if [ "$skip" = false ]; then
    chezmoi re-add "$file" > /dev/null 2>&1 || true
  fi
done

# Stage and commit if there are changes
if [[ -n $(git status -s) ]]; then
    MSG="${1:-Auto-save $(date +'%Y-%m-%d %H:%M')}"
    git add -u
    git commit -m "$MSG"

    # Push gate: hermetic OpenCode config check when config-relevant files
    # changed. Skipped when nix is unavailable (WSL has no Nix). A failure
    # blocks the push — the committed state is what the check evaluates.
    if command -v nix >/dev/null 2>&1; then
        if git diff --name-only HEAD~1 2>/dev/null | grep -qE '^(\.chezmoidata/|private_dot_config/opencode/|flake\.nix$|tests/config\.nix$)'; then
            echo ">> Config files changed — running hermetic config check..."
            if ! nix build .#checks.x86_64-linux.opencode-config -L; then
                echo ">> ✗ Config check FAILED — push blocked."
                echo "   Fix or revert, recommit, then re-run sys-save."
                exit 1
            fi
        fi
    fi

    echo ">> Pushing to GitHub..."
    git push origin master
    echo ">> Done."
else
    echo ">> No changes to save."
fi
