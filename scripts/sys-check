#!/bin/bash
# sys-check — smoke tests to verify system matches declared state
# Run after sys-sync or manually to validate system health

ERRORS=0

check_service() {
    if systemctl is-active --quiet "$1" 2>/dev/null; then
        echo "  ✓ $1"
    else
        echo "  ✗ $1 (not running)"
        ERRORS=$((ERRORS + 1))
    fi
}

echo ">> Running smoke tests..."

echo "Services:"
check_service docker
check_service firewalld
check_service NetworkManager
check_service bluetooth
check_service cups

echo "Kernel:"
if grep -q "mitigations=off" /proc/cmdline 2>/dev/null; then
    echo "  ✓ mitigations=off"
else
    echo "  ✗ mitigations=off not active"
    ERRORS=$((ERRORS + 1))
fi

echo "MSI EC:"
if lsmod | grep -q msi_ec 2>/dev/null; then
    echo "  ✓ msi_ec loaded"
else
    echo "  ✗ msi_ec not loaded"
    ERRORS=$((ERRORS + 1))
fi

echo "Locale:"
if [[ "$LANG" == "en_GB.UTF-8" ]]; then
    echo "  ✓ LANG=en_GB.UTF-8"
else
    echo "  ✗ LANG=$LANG (expected en_GB.UTF-8)"
    ERRORS=$((ERRORS + 1))
fi

echo "SSH agent:"
if ssh-add -l &>/dev/null; then
    echo "  ✓ keys loaded"
else
    echo "  ✗ no keys loaded"
    ERRORS=$((ERRORS + 1))
fi

echo "Chezmoi:"
if command -v chezmoi &>/dev/null; then
    echo "  ✓ installed"
else
    echo "  ✗ not found"
    ERRORS=$((ERRORS + 1))
fi

echo "KDE theme:"
# Plasma >= 6.3 stores ColorSchemeHash instead of the scheme name string.
# BreezeDark = 9d38eb71ded8ff549da26d57d7cbab9164da243a (stable content hash).
if grep -qE "ColorScheme=BreezeDark|ColorSchemeHash=9d38eb71ded8ff549da26d57d7cbab9164da243a" ~/.config/kdeglobals 2>/dev/null; then
    echo "  ✓ Breeze Dark"
else
    echo "  ✗ theme not set"
    ERRORS=$((ERRORS + 1))
fi

echo "Docker containers:"
if docker ps --format "{{.Names}}" 2>/dev/null | grep -q portainer; then
    echo "  ✓ portainer running"
else
    echo "  ✗ portainer not running"
    ERRORS=$((ERRORS + 1))
fi

echo "Tailscale:"
if command -v tailscale &>/dev/null; then
    if systemctl is-active --quiet tailscaled 2>/dev/null; then
        echo "  ✓ tailscaled running"
        TS_STATE=$(tailscale status --json 2>/dev/null | grep -o '"BackendState"[^,]*' | head -1)
        if echo "$TS_STATE" | grep -q 'Running'; then
            TS_IP=$(tailscale ip -4 2>/dev/null | head -1)
            echo "  ✓ enrolled (${TS_IP:-no ip})"
        else
            echo "  ✗ not enrolled (${TS_STATE:-no state})"
            ERRORS=$((ERRORS + 1))
        fi
    else
        echo "  ✗ tailscaled not running"
        ERRORS=$((ERRORS + 1))
    fi
else
    echo "  ✗ tailscale not installed"
    ERRORS=$((ERRORS + 1))
fi

if [[ $ERRORS -eq 0 ]]; then
    echo ">> All checks passed."
else
    echo ">> $ERRORS check(s) failed."
fi
exit $ERRORS
