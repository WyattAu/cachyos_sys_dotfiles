#!/bin/bash
# sys-check — smoke tests to verify system matches declared state
# Run after sys-sync or manually to validate system health
#
# Host profiles:
#   MSI laptops (msi-ge66, msi-z16)  → mitigations + msi_ec checks
#   Headless servers (no $DISPLAY)    → KDE checks skipped
#   Everything else                   → core checks only

ERRORS=0
HOSTNAME_STR="$(hostname)"
IS_MSI=false
[[ "$HOSTNAME_STR" == msi-* ]] && IS_MSI=true
IS_HEADLESS=true
[[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] || pgrep -x plasmashell >/dev/null 2>&1 && IS_HEADLESS=false

check_service() {
    if systemctl is-active --quiet "$1" 2>/dev/null; then
        echo "  ✓ $1"
    else
        echo "  ✗ $1 (not running)"
        ERRORS=$((ERRORS + 1))
    fi
}

echo ">> Running smoke tests on $HOSTNAME_STR (msi=$IS_MSI, headless=$IS_HEADLESS)..."

echo "Services:"
check_service docker
check_service firewalld
check_service NetworkManager
if [[ "$IS_HEADLESS" == false ]]; then
    check_service bluetooth
    check_service cups
fi

if [[ "$IS_MSI" == true ]]; then
    echo "Kernel:"
    if grep -q "mitigations=off" /proc/cmdline 2>/dev/null; then
        echo "  ✓ mitigations=off"
    else
        echo "  ✗ mitigations=off not active"
        ERRORS=$((ERRORS + 1))
    fi

    echo "MSI EC:"
    if lsmod | grep -q msi_ec 2>/dev/null; then
        echo "  ✓ msi_ec loaded"
    else
        echo "  ✗ msi_ec not loaded"
        ERRORS=$((ERRORS + 1))
    fi
fi

echo "Locale:"
if [[ "$LANG" == "en_GB.UTF-8" ]]; then
    echo "  ✓ LANG=en_GB.UTF-8"
else
    echo "  ✗ LANG=$LANG (expected en_GB.UTF-8)"
    ERRORS=$((ERRORS + 1))
fi

echo "SSH agent:"
if ssh-add -l &>/dev/null; then
    echo "  ✓ keys loaded"
else
    echo "  ✗ no keys loaded"
    ERRORS=$((ERRORS + 1))
fi

echo "Chezmoi:"
if command -v chezmoi &>/dev/null; then
    echo "  ✓ installed"
else
    echo "  ✗ not found"
    ERRORS=$((ERRORS + 1))
fi

if [[ "$IS_HEADLESS" == false ]]; then
    echo "KDE theme:"
    # Plasma >= 6.3 stores ColorSchemeHash instead of the scheme name string.
    # BreezeDark = 9d38eb71ded8ff549da26d57d7cbab9164da243a (stable content hash).
    if grep -qE "ColorScheme=BreezeDark|ColorSchemeHash=9d38eb71ded8ff549da26d57d7cbab9164da243a" ~/.config/kdeglobals 2>/dev/null; then
        echo "  ✓ Breeze Dark"
    else
        echo "  ✗ theme not set"
        ERRORS=$((ERRORS + 1))
    fi
fi

echo "Docker containers:"
if docker ps --format "{{.Names}}" 2>/dev/null | grep -q portainer; then
    echo "  ✓ portainer running"
else
    echo "  ✗ portainer not running"
    ERRORS=$((ERRORS + 1))
fi

echo "Tailscale:"
if command -v tailscale &>/dev/null; then
    if systemctl is-active --quiet tailscaled 2>/dev/null; then
        echo "  ✓ tailscaled running"
        TS_STATE=$(tailscale status --json 2>/dev/null | grep -o '"BackendState"[^,]*' | head -1)
        if echo "$TS_STATE" | grep -q 'Running'; then
            TS_IP=$(tailscale ip -4 2>/dev/null | head -1)
            echo "  ✓ enrolled (${TS_IP:-no ip})"
        else
            echo "  ✗ not enrolled (${TS_STATE:-no state})"
            ERRORS=$((ERRORS + 1))
        fi
    else
        echo "  ✗ tailscaled not running"
        ERRORS=$((ERRORS + 1))
    fi
else
    echo "  ✗ tailscale not installed"
    ERRORS=$((ERRORS + 1))
fi

echo "OpenCode toolchain:"
# Binary
if [[ -x "$HOME/.opencode/bin/opencode" ]]; then
    echo "  ✓ opencode binary"
else
    echo "  ✗ opencode binary missing (~/.opencode/bin/opencode)"
    ERRORS=$((ERRORS + 1))
fi
# Global config parses as JSONC (strip // comments, then parse).
# Catches chezmoi template regressions at smoke-test time, not session time.
if [[ -f "$HOME/.config/opencode/opencode.jsonc" ]]; then
    if node -e '
const fs = require("fs");
let s = fs.readFileSync(process.argv[1], "utf8"), o = "", inStr = false, inCmt = false;
for (let i = 0; i < s.length; i++) {
  const c = s[i], n = s[i + 1];
  if (inCmt) { if (c === "\n") { inCmt = false; o += c; } continue; }
  if (inStr) { o += c; if (c === "\"" && s[i - 1] !== "\\") inStr = false; continue; }
  if (c === "\"") { inStr = true; o += c; continue; }
  if (c === "/" && n === "/") { inCmt = true; continue; }
  o += c;
}
JSON.parse(o);' "$HOME/.config/opencode/opencode.jsonc" >/dev/null 2>&1; then
        echo "  ✓ opencode.jsonc valid"
    else
        echo "  ✗ opencode.jsonc does not parse — fix private_dot_config/opencode template"
        ERRORS=$((ERRORS + 1))
    fi
else
    echo "  ✗ opencode.jsonc missing (run: chezmoi apply)"
    ERRORS=$((ERRORS + 1))
fi
# MCP backends — ghidra-mcp may only be at ~/.local/bin (systemd PATH is minimal)
for tool in r2pm bunx; do
    if command -v "$tool" >/dev/null 2>&1; then
        echo "  ✓ $tool"
    else
        echo "  ✗ $tool not on PATH"
        ERRORS=$((ERRORS + 1))
    fi
done
if command -v ghidra-mcp >/dev/null 2>&1 || [[ -x "$HOME/.local/bin/ghidra-mcp" ]]; then
    echo "  ✓ ghidra-mcp"
else
    echo "  ✗ ghidra-mcp missing (opencode ansible role / uv tool)"
    ERRORS=$((ERRORS + 1))
fi
# r2mcp installed (r2pm -l exits 1 when the package db is empty)
if r2pm -l 2>/dev/null | grep -q r2mcp; then
    echo "  ✓ r2mcp installed"
else
    echo "  ✗ r2mcp not installed (r2pm -Uci r2mcp)"
    ERRORS=$((ERRORS + 1))
fi
# GhidraMCP extension in any Ghidra user dir
EXT_FOUND=false
for d in "$HOME"/.ghidra/.ghidra_*_PUBLIC; do
    [[ -f "$d/Extensions/GhidraMCP/extension.properties" ]] && EXT_FOUND=true
done
if [[ "$EXT_FOUND" == true ]]; then
    echo "  ✓ GhidraMCP extension"
else
    echo "  ✗ GhidraMCP extension missing (opencode ansible role)"
    ERRORS=$((ERRORS + 1))
fi
# GitHub MCP server binary + its token source. The MCP config spawns the
# server through `gh auth token`, so a missing token means the github
# MCP fails at handshake even though the binary is fine.
if [[ -x "$HOME/.local/bin/github-mcp-server" ]] || command -v github-mcp-server >/dev/null 2>&1; then
    echo "  ✓ github-mcp-server"
else
    echo "  ✗ github-mcp-server missing (opencode ansible role)"
    ERRORS=$((ERRORS + 1))
fi
# RE/malware analysis toolkit (Reversecore_MCP via uv)
if command -v reversecore-mcp >/dev/null 2>&1; then
    echo "  ✓ reversecore-mcp"
else
    echo "  ✗ reversecore-mcp missing (ansible opencode role: uv tool install)"
    ERRORS=$((ERRORS + 1))
fi
# Code knowledge graph server
if command -v codebase-memory-mcp >/dev/null 2>&1; then
    echo "  ✓ codebase-memory-mcp"
else
    echo "  ✗ codebase-memory-mcp missing (AUR: codebase-memory-mcp-bin)"
    ERRORS=$((ERRORS + 1))
fi
if gh auth token >/dev/null 2>&1; then
    echo "  ✓ gh token available (github MCP auth)"
else
    echo "  ✗ gh not authenticated — github MCP cannot start (gh auth login)"
    ERRORS=$((ERRORS + 1))
fi
# Playwright chromium cache
if ls -d "$HOME"/.cache/ms-playwright/chromium-* >/dev/null 2>&1; then
    echo "  ✓ playwright chromium"
else
    echo "  ✗ playwright chromium missing (bunx playwright install chromium)"
    ERRORS=$((ERRORS + 1))
fi
# Terraform MCP image — only fails when docker works but the image is absent
if docker info >/dev/null 2>&1; then
    if docker image inspect hashicorp/terraform-mcp-server:1.3.0 >/dev/null 2>&1; then
        echo "  ✓ terraform MCP image"
    else
        echo "  ✗ terraform MCP image not pulled (opencode ansible role)"
        ERRORS=$((ERRORS + 1))
    fi
else
    echo "  ⚠ terraform MCP image check skipped (docker down)"
fi

if [[ $ERRORS -eq 0 ]]; then
    echo ">> All checks passed."
else
    echo ">> $ERRORS check(s) failed."
    # Send Telegram alert on failure
    TELEGRAM_TOKEN_FILE="/etc/alertmanager/telegram-token"
    # NOTE: this file is NOT a chezmoi template (symlinked straight from the
    # source repo), so chat_id is hardcoded — it is already plaintext in
    # host_vars/common.yml. Only the token lives outside the repo.
    CHAT_ID="8905506473"
    if [[ -f "$TELEGRAM_TOKEN_FILE" && "$CHAT_ID" != "0" ]]; then
        TOKEN=$(cat "$TELEGRAM_TOKEN_FILE")
        HOSTNAME=$(hostname)
        MSG="⚠️ sys-check: $HOSTNAME — $ERRORS check(s) failed"
        curl -s -X POST "https://api.telegram.org/bot${TOKEN}/sendMessage" \
            -d chat_id="$CHAT_ID" \
            -d text="$MSG" \
            -d parse_mode="Markdown" >/dev/null 2>&1 || true
    fi
fi
exit $ERRORS
