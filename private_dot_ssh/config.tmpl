# SSH Configuration
# Managed by chezmoi — edit the source, not this file

# Forgejo Git SSH — direct LAN (CF tunnel SSH broken: websocket handshake).
# Port 2222 = Forgejo builtin SSH server on TrueNAS (container 2522).
# ControlMaster disabled: git push channels must not multiplex through a
# long-lived master (stuck masters wedge pushes indefinitely).
Host git.wyattau.com
    HostName 192.168.1.3
    Port 2222
    User git
    IdentityFile ~/.ssh/id_ed25519_forgejo
    StrictHostKeyChecking no
    ControlMaster no
    ControlPath none

Host ssh.wyattau.com
    HostName 192.168.1.3
    Port 2222
    User git
    IdentityFile ~/.ssh/id_ed25519_forgejo
    ControlMaster no
    ControlPath none
    StrictHostKeyChecking no

# Forgejo alias
Host forgejo
    HostName 192.168.1.3
    Port 2222
    User git
    IdentityFile ~/.ssh/id_ed25519_forgejo
    ControlMaster no
    ControlPath none
    StrictHostKeyChecking no

# Global defaults
Host *
    AddKeysToAgent yes
    IdentityAgent ~/.ssh/agent.sock
    ForwardAgent no
    Compression yes
    # No TCP keepalive — use SSH-level instead
    TCPKeepAlive no
    ServerAliveInterval 60
    ServerAliveCountMax 3
    # Connection reuse
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 10m

# ── Local servers ──

# TrueNAS server (direct LAN access)
Host truenas
    HostName {{ .truenas_ip | default "192.168.1.3" }}
    User truenas_admin
    IdentityFile ~/.ssh/id_ed25519

# ── Tailnet (Headscale mesh VPN) ──
# Works from anywhere; falls back to LAN entries above when at home

# CachyOS headless server (192.168.1.191)
Host cachyos-x8664 cachyos-server
    HostName 100.64.0.2
    User wyatt
    IdentityFile ~/.ssh/id_ed25519

# Acer desktop
Host wyattdeskacercachy acer
    HostName 100.64.0.3
    User wyatt
    IdentityFile ~/.ssh/id_ed25519

# TrueNAS over the tailnet
Host truenas-ts
    HostName 100.64.0.8
    User truenas_admin
    IdentityFile ~/.ssh/id_ed25519

# ── Cloud / Git ──

# ── GitHub ──
Host github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    # GitHub doesn't need keepalive for quick pushes

# ── WSL / localhost ──
Host localhost 127.0.0.1
    User {{ .name | default "wyatt" | lower | replace " " "" }}
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
