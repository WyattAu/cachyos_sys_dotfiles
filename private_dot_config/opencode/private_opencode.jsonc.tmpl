{
  "$schema": "https://opencode.ai/config.json",
  // Managed by chezmoi — edit the source repo, not this file.
  //
  // Servers are gated by .chezmoidata/defaults.toml [opencode.mcp] flags;
  // disable per host in ~/.config/chezmoi/chezmoi.toml under [data.opencode.mcp].
  //
  // Model/provider auth is deliberately NOT set here: run `opencode auth login`
  // per machine and pick the default model in the TUI. Add a "model" field here
  // only if you want one pinned fleet-wide.
  //
  // One-time per machine after first apply:
  //   gh auth login                       (GitHub MCP token source — see below)
  //   Ghidra: File -> Configure -> Developer -> enable GhidraMCPPlugin

  "mcp": {
    // Cold bunx/uvx downloads on first launch exceed the 30s default startup.
    "timeout": {
      "startup": 90000
    },
    "servers": {
{{- $mcp := .opencode.mcp }}
{{- if $mcp.context7 }}
      // ---- Docs & research ------------------------------------------
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
{{- end }}
{{- if $mcp.github }}
      // ---- GitHub -----------------------------------------------------
      // Official server (github-mcp-server, installed by the 'opencode'
      // role) in local stdio mode. NOT the api.githubcopilot.com
      // remote: that endpoint needs a Copilot entitlement and fails to
      // authenticate without one. The token comes from the gh keyring
      // at spawn time (gh auth token), so no secret lives in this file
      // and gh's own expiry/rotation rules apply. `exec` replaces the
      // shell so signals/stdio pass through untouched.
      // Needs: repo, workflow, read:org (gh auth refresh -s ...).
      "github": {
        "type": "local",
        "command": [
          "/bin/bash", "-c",
          "export GITHUB_PERSONAL_ACCESS_TOKEN=\"$(gh auth token 2>/dev/null)\"; [ -n \"$GITHUB_PERSONAL_ACCESS_TOKEN\" ] || { echo 'github-mcp: no gh token — run: gh auth login' >&2; exit 1; }; exec github-mcp-server stdio --toolsets repos,issues,pull_requests,actions,code_security"
        ]
      },
{{- end }}
{{- if $mcp.fetch }}
      // ---- Web & reasoning -------------------------------------------
      "fetch": {
        "type": "local",
        "command": ["uvx", "mcp-server-fetch"]
      },
{{- end }}
{{- if $mcp.sequential_thinking }}
      "sequential-thinking": {
        "type": "local",
        "command": ["bunx", "@modelcontextprotocol/server-sequential-thinking"]
      },
{{- end }}
{{- if $mcp.memory }}
      // Persistent cross-session memory (knowledge graph JSON below).
      "memory": {
        "type": "local",
        "command": ["bunx", "@modelcontextprotocol/server-memory"],
        "environment": {
          "MEMORY_FILE_PATH": "{{ .chezmoi.homeDir }}/.local/share/opencode/memory.json"
        }
      },
{{- end }}
{{- if $mcp.git }}
      // ---- Dev workflow ----------------------------------------------
      "git": {
        "type": "local",
        "command": ["uvx", "mcp-server-git"]
      },
{{- end }}
{{- if $mcp.dbhub }}
      // Disabled globally: DBs are project-specific. In a project's
      // opencode.jsonc, redefine "dbhub" (same shape) with your DSN —
      // project config replaces this object wholesale.
      // DBHub (bytebase; the official MCP-registry database example):
      // SQLite/Postgres/MySQL/MariaDB/SQL Server/Oracle behind TWO tools
      // (execute_sql, search_objects) at ~1.4k tokens — 13x lighter than
      // per-database alternatives. Read-only mode + row limits + query
      // timeouts are built in; flip read-only off per project if needed.
      "dbhub": {
        "type": "local",
        "command": [
          "bunx", "@bytebase/dbhub@latest",
          "--transport", "stdio",
          "--dsn", "sqlite://./local.db"
        ],
        "disabled": true
      },
{{- end }}
{{- if $mcp.filesystem }}
      // ---- Filesystem -------------------------------------------------
      // Sandboxed to ~/dev (same root as the r2mcp sandbox): every
      // read/write tool refuses paths outside it. bunx caches after the
      // first launch (the 'opencode' role prewarms it).
      // NOTE: in code mode (tools.* routed through the execute runtime)
      // filesystem.* can be a workspace-rooted shim instead of this
      // server — a "path outside allowed directories" error naming the
      // project root means the shim, not a broken sandbox root here.
      "filesystem": {
        "type": "local",
        "command": [
          "bunx", "-y", "@modelcontextprotocol/server-filesystem",
          "{{ .chezmoi.homeDir }}/dev"
        ]
      },
{{- end }}
{{- if $mcp.codebase_memory }}
      // ---- Code knowledge graph --------------------------------------
      // codebase-memory-mcp (AUR: codebase-memory-mcp-bin): indexes a repo
      // into a persistent tree-sitter graph (clawdius: ~30k nodes / 105k
      // edges); search_graph/get_architecture replace grep/read cycles.
      // Indexes on demand: the agent calls index_repository once per repo,
      // the graph persists across sessions (project name = mangled path).
      "codebase-memory": {
        "type": "local",
        "command": ["codebase-memory-mcp"]
      },
{{- end }}
{{- if $mcp.reversecore }}
      // ---- RE / malware analysis toolkit -----------------------------
      // Reversecore_MCP v3.4.4 (151 tools): radare2 sessions + r2ghidra
      // decompilation + YARA + CAPA + LIEF + IOC extraction. Installed by
      // the ansible role via:
      //   uv tool install --python 3.12 reversecore-mcp \
      //     --with lief --with r2pipe
      // (the 3.12 pin is load-bearing: numpy has no wheel for 3.14 and
      // the meson build fails on this GCC).
      // Runs with CWD = ~/dev/sandbox — the same sample convention as the
      // r2mcp sandbox: drop samples there, open them by name. The agent
      // cannot ingest arbitrary system binaries without placing them.
      "reversecore": {
        "type": "local",
        "command": [
          "/bin/bash", "-c",
          "cd \"{{ .chezmoi.homeDir }}/dev/sandbox\" && exec reversecore-mcp"
        ]
      },
{{- end }}
{{- if $mcp.time }}
      // ---- Reference servers (modelcontextprotocol/servers) ----------
      "time": {
        "type": "local",
        "command": ["uvx", "mcp-server-time"]
      },
{{- end }}
{{- if $mcp.sentry }}
      // ---- Error tracking ---------------------------------------------
      // Official Sentry MCP. Remote + OAuth: authenticate once via
      // /mcps -> sentry -> authenticate. The 401 without auth is the
      // endpoint working as designed.
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp"
      },
{{- end }}
{{- if $mcp.linear }}
      // ---- Project tracking -------------------------------------------
      // Official Linear MCP (streamable HTTP). OAuth via /mcps -> linear.
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
{{- end }}
{{- if $mcp.firecrawl }}
      // ---- Web crawl / extract ----------------------------------------
      // JS rendering, crawling, structured extraction — beyond fetch's
      // single-page markdown. Needs FIRECRAWL_API_KEY exported in your
      // shell (the MCP process inherits it) — without it the server
      // exits with a message naming the variable.
      "firecrawl": {
        "type": "local",
        "command": ["bunx", "-y", "firecrawl-mcp"]
      },
{{- end }}
{{- if $mcp.exa }}
      // ---- Neural web search ------------------------------------------
      // Complements the built-in websearch: Exa's neural ranking for
      // "find me papers/code like X" queries. Needs EXA_API_KEY exported
      // in your shell.
      "exa": {
        "type": "local",
        "command": ["bunx", "-y", "exa-mcp-server"]
      },
{{- end }}
{{- if $mcp.terraform }}
      // ---- Infrastructure as Code ------------------------------------
      // HashiCorp Terraform Registry lookups (providers, modules, policies).
      // Image pre-pulled by the ansible 'opencode' role.
      "terraform": {
        "type": "local",
        "command": ["docker", "run", "-i", "--rm", "hashicorp/terraform-mcp-server:1.3.0"]
      },
{{- end }}
{{- if $mcp.playwright }}
      // ---- Browser automation ----------------------------------------
      "playwright": {
        "type": "local",
        "command": ["node", "{{ .chezmoi.homeDir }}/.local/share/opencode/mcp-playwright/node_modules/@playwright/mcp/cli.js", "--browser", "chromium"]
      },
{{- end }}
{{- if $mcp.radare2 }}
      // ---- Reverse engineering ---------------------------------------
      // r2mcp: static analysis, decompile, ESIL emulation, live debug.
      // Sandboxed to ~/dev (-s takes ONE dir: repeated flags replace and
      // colon lists break opening entirely — verified empirically).
      // Samples elsewhere must be copied into ~/dev/sandbox first.
      "radare2": {
        "type": "local",
        "command": [
          "r2pm", "-r", "r2mcp",
          "-s", "{{ .chezmoi.homeDir }}/dev"
        ]
      },
{{- end }}
{{- if $mcp.ghidra }}
      // GhidraMCP v2: GUI mode — tools answer while Ghidra runs with a
      // program open (loopback HTTP backend). Headless alternative:
      //   ghidra-mcp --headless --binary <path>
      "ghidra": {
        "type": "local",
        "command": ["ghidra-mcp"]
      }
{{- end }}
    }
  },

  // Ordered rules; last match wins. Complements the TUI's autoaccept setting.
  "permissions": [
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" }
  ],

  // Fleet IaC repo as opt-in supporting context — the agent can pull host
  // inventory, workflows, and service topology from its README on demand.
  "references": {
    "dotfiles": {
      "path": "{{ .chezmoi.homeDir }}/.local/share/chezmoi",
      "description": "Fleet infrastructure-as-code (chezmoi + ansible): hosts, sys-* workflows, service topology — start at README.md"
    }
  }
}
